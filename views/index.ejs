<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog</title>

    <link rel="stylesheet" href="/styles/main.css">
</head>
<body>
    <div class="container">
        <h1>My Blog</h1>
        <a href="/new" id="newPostBtn">New Post</a>
        <ul id="postsList">
            <% posts.forEach(post=> { %>
                <h2>
                    <%= post.title %>
                </h2>
                <small>
                    <%= post.date %>
                </small>
                <p>
                    <%= post.content %>
                </p>
                <small>
                    By: <%= post.author %>
                </small>
                <a href="/edit/<%= post.id %>" class="edit">
                    Edit
                </a>
                <a href="/api/posts/delete/<%= post.id %>" class="delete">
                    Delete
                </a>
            <% }); %>
        </ul>
    </div>
</body>
</html>